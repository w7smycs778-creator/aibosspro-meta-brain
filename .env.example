MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required: the server refuses to start without it. Hard ceiling 130; keep it low for a trial.
MODEL_SPEND_HARD_CAP_USD=5
# Credit left in Meta Model API Billing; required for live calls (an unknown balance fails closed).
MODEL_CREDIT_BALANCE_USD=
# Never set by code. Hosted inference also needs STORAGE_BACKEND=supabase and a reachable ledger.
LIVE_CREDITS_VERIFIED=
# local (SQLite under STORAGE_DIR, default ./data) or supabase. Hosted deploys must use supabase.
STORAGE_BACKEND=local
STORAGE_DIR=
TOOL_LOOP_MAX_ITERATIONS=6
# native: OpenAI-style tools (probed and used live on 2026-10-29). json (code default): tools described in the system prompt, one JSON object back.
MODEL_TOOL_MODE=native
MODEL_CHAT_MODEL=muse-spark-1.3
# Local only: "mock" answers the customer panel from the scripted demo, no model calls.
MODEL_CLIENT=
# Business served by the WhatsApp number; defaults to the seeded demo business.
WHATSAPP_BUSINESS_ID=
