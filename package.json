    "judge": "bash scripts/judge.sh",
    "demo:reset": "STORAGE_BACKEND=local tsx scripts/demo-reset.ts",
    "seed:demo-businesses": "STORAGE_BACKEND=local tsx scripts/seed-demo-businesses.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "@supabase/supabase-js": "^2.109.0",
    "better-sqlite3": "^12.11.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
